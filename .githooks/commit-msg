#!/usr/bin/env bash
# Reject `Co-Authored-By: Claude` trailers before a commit is written.
#
# POLICY.md P5.5: Claude is not a legal author; the trailer falsely implies
# authorship on GitHub. AI assistance is CITED via the
# `[autogenerated by Claude <model> v<version> on <datetime>]` footer, never
# attributed. The trailer is injected by default by some tooling, so a reminder
# does not hold -- this hook makes the violation a mechanical block.
#
# Activation (one-time per clone): `git config core.hooksPath .githooks`.
# The `authorize-git-operation` gate is the mandatory backstop that also checks
# for this trailer at push time, so an unactivated hook degrades to the gate,
# never to silence.
set -euo pipefail

msg_file="$1"

# Match a trailer line naming Claude/claude-* as co-author (case-insensitive,
# tolerant of surrounding whitespace). Does not match prose that merely mentions
# the phrase "Co-Authored-By" (the line must START with the trailer).
if grep -qiE '^[[:space:]]*Co-Authored-By:[[:space:]]*claude' "$msg_file"; then
  echo "commit-msg: refusing a 'Co-Authored-By: Claude' trailer (POLICY.md P5.5)." >&2
  echo "  Claude is cited, not attributed: use" >&2
  echo "  '[autogenerated by Claude <model> v<version> on <datetime>]' instead." >&2
  echo "  Remove the trailer and re-commit." >&2
  exit 1
fi

exit 0

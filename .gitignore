.pytest_cache/
__pycache__/
*.py[cod]
.beads.gate.lock

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Local machine-layout note (operator-specific; not shared)
CONTEXT.md

# Generated skill/agent sinks and local build state (P1.3: never commit a
# materialized sink -- .claude/skills/** are generated symlinks)
.claude/
.agents/
.gc/
.gc-builds/

# Local MCP client registration — session-specific, not shared config.
.mcp.json

# Salvage scratch — recovered//staging material, not shared history.
docs/salvage/

# Codex harness state — machine-local config + agent run reports.
.codex/

# Path-bug artifact: a relative write from inside the repo created a nested
# ~/gt/mathcity/mathcity/.codex/. Root-anchored so a legitimately-named
# mathcity/ subdirectory elsewhere in the tree is unaffected.
/mathcity/

# The bead store is machine-local and is not tracked -- except identity.toml,
# which carries the scope's canonical project id. That file declares itself
# git-tracked, and a clone without it cannot resolve which bead scope it
# belongs to. Ignore the store, keep the identity.
.beads/*
!.beads/identity.toml

# Formula worktrees. `do-work.prepare-worktree` creates a NESTED CHECKOUT at
# $(pwd)/worktrees/<source-anchor-id> inside this repo (gascity-packs asset
# gascity/assets/workflows/do-work/prepare-worktree.md, step 4). The asset never
# says to ignore it, so without this line every prepared worktree shows up as
# untracked and one `git add -A` commits an entire second checkout.
# mathcity-testrig already carries this line; mathcity did not.
worktrees/
